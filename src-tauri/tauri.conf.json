{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Familiar",
  "version": "0.1.3",
  "identifier": "app.familiar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Familiar",
        "url": "index.html#main",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false
      },
      {
        "label": "bar",
        "url": "index.html#bar",
        "width": 680,
        "height": 58,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "label": "character",
        "url": "index.html#character",
        "width": 360,
        "height": 203,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "visible": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://*.supabase.co https://avatars.githubusercontent.com https://*.googleusercontent.com https://*.klipy.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://*.supabase.co wss://*.supabase.co; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/packs/**",
          "$RESOURCE/packs/**"
        ]
      },
      "devCsp": "default-src 'self' http://localhost:1420; script-src 'self' 'unsafe-inline' http://localhost:1420; img-src 'self' asset: http://asset.localhost data: blob: https://*.supabase.co https://avatars.githubusercontent.com https://*.googleusercontent.com https://*.klipy.com http://localhost:1420; style-src 'self' 'unsafe-inline' http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co ws://localhost:1420 http://localhost:1420; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI quick bar with an animated companion",
    "resources": {
      "../packs/builtin": "packs",
      "resources/install-node-cli.sh": "resources/install-node-cli.sh"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "familiar"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEOTIwOEFDODEzNjI1QzcKUldUSEpUYUJyQWlTYlQwcnF3aXpjcDhaZlRrMy9ZNTNsdW9wNVFBZUFuVTgyQ3VtWFMyaUJQQXoK",
      "endpoints": [
        "https://github.com/vvalmogl/familiar/releases/latest/download/latest.json"
      ]
    }
  }
}
