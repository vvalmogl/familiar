# Copy to .env (git-ignored). Accounts, sync and the pack gallery are hidden when unset.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable anon key>

# Server-side only (never VITE_*): Resend API key for Supabase auth emails, used by `supabase config push`.
RESEND_API_KEY=
